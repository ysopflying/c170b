 <aerodynamics>
    <function name="aero/force/Drag_total">
       <description>Drag due to Elevator Deflection</description>
	<sum>
           <property>aero/force/Drag_elevator</property>
           <property>aero/force/Drag_basic</property>
<!--           <property>aero/force/Drag_induced</property> -->
	   <property>aero/force/Drag_flap</property>
	   <property>aero/force/Drag_elevator</property>
	</sum>
    </function>	
    <function name="aero/function/aileron-mean">
       <description>represents aileron deflection without differential reduction</description>
	<product>
	<avg>
           <property>fcs/left-aileron-pos-rad</property>
           <property>fcs/right-aileron-pos-rad</property>
	</avg>
	<value>1.176</value> <!-- scale up to 20deg -->
	</product>
    </function>	

<!-- ########################################################### -->

    <function name="aero/function/checkalpha">
       <description>local alpha1</description>
	<atan>
		<quotient>
			<p>velocities/w-aero-fps</p>
			<p>velocities/u-aero-fps</p>
		</quotient>

	</atan>
    </function>	

    <function name="aero/function/local alpha1right">
       <description>local alpha1</description>
	<atan>
		<quotient>
		<sum>
			<p>velocities/w-aero-fps</p>
			<product>
			<p>velocities/p-aero-rad_sec</p>
				<value>10</value>		<!--	l2 -->
			</product>
		</sum>
		<sum>
			<p>velocities/u-aero-fps</p>
			<product>
				<p>velocities/r-aero-rad_sec</p>
				<value>8</value>		<!--	l1 -->
			</product>
		</sum>
		</quotient>
	</atan>
    </function>	

    <function name="aero/function/local betastab">
       <description>local beta at stabilizer</description>

	<sum>
	<p>aero/beta-rad</p>
	<atan>
		<quotient>
		<sum>
			<p>velocities/v-aero-fps</p>
			<product>
			<p>velocities/r-aero-rad_sec</p>
				<value>10</value>		<!--	l3 -->
			</product>
		</sum>
			<p>velocities/u-aero-fps</p>
		</quotient>
	</atan>
	</sum>
    </function>	

    <function name="aero/function/local alphastab">
       <description>local alpha1</description>
	<atan>
		<quotient>
		<sum>
			<product>
			<p>velocities/w-aero-fps</p>
			<value>-1</value>
			</product>
			<product>
			<p>velocities/q-aero-rad_sec</p>
				<value>10</value>		<!--	l4 -->
			</product>
		</sum>
		<sum>
			<p>velocities/u-aero-fps</p>
			<product>
				<p>velocities/q-aero-rad_sec</p>
				<value>10</value>		<!--	l4 -->
			</product>
		</sum>
		</quotient>
	</atan>
    </function>	

